# Gemini API Key (Secret - Get from Google AI Studio)
GEMINI_API_KEY=

# Gemini Models
GEMINI_CHAT_MODEL=gemini-3.7-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

# RAG Retrieval Tuning
SIMILARITY_THRESHOLD=0.60
TOP_K=5

# Supabase Credentials (Get from Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS Allowed Origins (comma-separated URLs, e.g. local dev + Vercel deployment URL)
ALLOWED_ORIGINS=http://localhost:3000

# Daily AI Quota Protection (in-memory demo safety limit)
GEMINI_DAILY_LIMIT=100
EMBED_DAILY_LIMIT=500
